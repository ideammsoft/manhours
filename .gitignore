# ─────────────────────────────────────────────
#  manHours .gitignore
#  빌드 산출물·디버그·민감정보는 커밋하지 않는다.
# ─────────────────────────────────────────────

# 빌드 산출물 (재생성되므로 제외 — dist 안에는 100MB+ exe 있음)
bin/
obj/
dist/
.vs/
*.user
*.suo

# 디버그 심볼
*.pdb

# 인증서 / 서명키 (실수로 폴더에 들어와도 제외)
*.pfx
*.snk
*.p12
*.key

# 민감 설정 (FTP 계정 등 — 원래 상위 폴더에 있지만 안전차원)
ftp_config.bat
appsettings.*.json
secrets.json
